          },
          "expr": "sum by (pod) (hikaricp_connections_active{namespace=\"$namespace\", job=~\"$job\"})",
          "legendFormat": "{{pod}} active",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (pod) (hikaricp_connections_pending{namespace=\"$namespace\", job=~\"$job\"})",
